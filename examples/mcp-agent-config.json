{
  "mcp": {
    "transport": "stdio",
    "command": "bun",
    "args": ["src/mcp/mcp-server.ts", "--repo", "."],
    "fallback": {
      "transport": "streamable-http",
      "url": "http://localhost:8081/mcp"
    },
    "tools": {
      "axiom_search": "Search the indexed codebase",
      "axiom_context": "Retrieve grounded engineering context",
      "axiom_dependencies": "Understand dependency relationships",
      "axiom_impact": "Determine affected components from a change",
      "axiom_memory": "Retrieve engineering memory and ADRs"
    }
  }
}
