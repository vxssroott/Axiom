{
  "version": 2,
  "builds": [
    {
      "src": "api/billing.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/billing/(.*)",
      "dest": "/api/billing.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
